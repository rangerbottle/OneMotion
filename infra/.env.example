# Backend (FastAPI) — copy to backend/.env and adjust
ONMOTION_DATA_DIR=../data
ONMOTION_POSE_BACKEND=yolo
ONMOTION_MODEL_PATH=../models/yolo11n-pose.pt
ONMOTION_ARTIFACT_MANIFEST=../infra/artifacts.json
ONMOTION_MEDIA_TTL_HOURS=24
ONMOTION_ALLOWED_ORIGINS=http://localhost:3000
ONMOTION_WARM_MODEL=false
ONMOTION_RF_API_KEY=

# Web (Next.js) — copy to apps/web/.env.local and adjust
NEXT_PUBLIC_API_BASE=http://localhost:8000
ONMOTION_API_BASE=http://localhost:8000

# Docker Compose
ONMOTION_PORT=3000
