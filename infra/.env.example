# Backend (FastAPI) — copy to backend/.env and adjust
ONEMOTION_DATA_DIR=../data
ONEMOTION_POSE_BACKEND=yolo
ONEMOTION_MODEL_PATH=../models/yolo11n-pose.pt
ONEMOTION_ARTIFACT_MANIFEST=../infra/artifacts.json
ONEMOTION_MEDIA_TTL_HOURS=24
ONEMOTION_ANALYSIS_CONCURRENCY=1
ONEMOTION_ANALYSIS_TIMEOUT_S=120
ONEMOTION_ALLOWED_ORIGINS=http://localhost:3000
ONEMOTION_WARM_MODEL=false
ONEMOTION_RF_API_KEY=

# Web (Next.js) — copy to apps/web/.env.local and adjust
NEXT_PUBLIC_API_BASE=http://localhost:8000
ONEMOTION_API_BASE=http://localhost:8000

# Docker Compose
ONEMOTION_PORT=3000
